# Local development settings for infra/compose.yaml.
# Copy this file to infra/.env (untracked) and replace every CHANGE_ME with a long random value.
# Never commit infra/.env. Never reuse these values in staging or prod.
# Completed in S01 task 9.

APP_ENV=dev
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://127.0.0.1:3000

# Postgres (bootstrap superuser is used only by the dev init script)
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
IMB_MIGRATOR_PASSWORD=CHANGE_ME
IMB_API_PASSWORD=CHANGE_ME
IMB_WORKER_PASSWORD=CHANGE_ME
IMB_OPS_RO_PASSWORD=CHANGE_ME

# Redis (required in every environment, S01 R2.4)
REDIS_PASSWORD=CHANGE_ME
